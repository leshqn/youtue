# Copy to .env and fill in to go live. All optional — the system runs on stubs
# with none of these set.

# LLM (Phase 2 real brains). Set llm.provider: anthropic in config.yaml too.
LLM_API_KEY=

# Text-to-video provider (Phase 4). Set video_generation.provider in config.yaml.
VIDEO_API_KEY=

# Social publishing + analytics (Phase 4). Any non-empty value selects the live
# adapter slot for that platform (which currently raises NotImplementedError
# until you implement it).
INSTAGRAM_GRAPH_API=
TIKTOK_API=
YOUTUBE_DATA_API=
TREND_DATA_SOURCE=
